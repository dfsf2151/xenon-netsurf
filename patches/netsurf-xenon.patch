diff --git a/content/handlers/html/dom_event.c b/content/handlers/html/dom_event.c
index 83a84ac..76b4286 100644
--- a/content/handlers/html/dom_event.c
+++ b/content/handlers/html/dom_event.c
@@ -577,6 +577,43 @@ static void html_texty_element_update(html_content *htmlc, dom_node *node)
 /**
  * callback for DOMNodeInserted end type
  */
+/**
+ * Whether an element carries an on* attribute, which needs a javascript
+ * context to bind.
+ */
+static bool html_node_has_event_attribute(dom_node *node)
+{
+	dom_namednodemap *map = NULL;
+	dom_ulong length = 0;
+	bool found = false;
+
+	if (dom_node_get_attributes(node, &map) != DOM_NO_ERR || map == NULL)
+		return false;
+
+	if (dom_namednodemap_get_length(map, &length) == DOM_NO_ERR) {
+		for (dom_ulong idx = 0; idx < length && !found; idx++) {
+			dom_attr *attr = NULL;
+			dom_string *name = NULL;
+
+			if (dom_namednodemap_item(map, idx, &attr) != DOM_NO_ERR ||
+			    attr == NULL)
+				continue;
+			if (dom_attr_get_name(attr, &name) == DOM_NO_ERR &&
+			    name != NULL) {
+				const char *text = dom_string_data(name);
+				if (dom_string_byte_length(name) > 2 &&
+				    (text[0] == 'o' || text[0] == 'O') &&
+				    (text[1] == 'n' || text[1] == 'N'))
+					found = true;
+				dom_string_unref(name);
+			}
+			dom_node_unref(attr);
+		}
+	}
+	dom_namednodemap_unref(map);
+	return found;
+}
+
 static void
