diff --git a/content/handlers/html/layout.c b/content/handlers/html/layout.c
index d3b6d8f..25c8615 100644
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -789,6 +789,13 @@ layout_minmax_line(struct box *first,
 	*line_min = min;
 	*line_max = max;
 
+	/* Some pages (DuckDuckGo Lite result rows) contain a replaced box
+	 * whose shrink-to-fit width ends up above the line maximum, usually
+	 * through a negative margin. Keep the invariant instead of aborting
+	 * the whole browser on a single odd page. */
+	if (*line_max < *line_min)
+		*line_max = *line_min;
+
 	NSLOG(layout, DEBUG,  "line_min %i, line_max %i", min, max);
 
 	assert(b != first);
